# Script mode (cmake -P), run by gb_add_shaders: writes a C++ source that embeds compiled SPIR-V modules as uint32_t
# arrays plus a table sorted by name, so that ShaderLibrary can binary-search it. Plain CMake on purpose: building the
# engine needs no Python (D-031).
#
# Inputs (-D): GB_MANIFEST (defines GB_SHADER_NAMES and GB_SHADER_BINARIES, parallel lists), GB_OUTPUT (the .cpp to
# write), GB_HEADER (the generated header that declares the function), GB_FUNCTION (the function's name).

cmake_minimum_required(VERSION 3.24)

foreach(GB_INPUT GB_MANIFEST GB_OUTPUT GB_HEADER GB_FUNCTION)
    if(NOT DEFINED ${GB_INPUT} OR "${${GB_INPUT}}" STREQUAL "")
        message(FATAL_ERROR "GambitEmbedShaders.cmake: ${GB_INPUT} is not set")
    endif()
endforeach()

include("${GB_MANIFEST}")
list(LENGTH GB_SHADER_NAMES GB_COUNT)
list(LENGTH GB_SHADER_BINARIES GB_BINARY_COUNT)
if(GB_COUNT EQUAL 0 OR NOT GB_COUNT EQUAL GB_BINARY_COUNT)
    message(FATAL_ERROR "GambitEmbedShaders.cmake: malformed manifest ${GB_MANIFEST}")
endif()

# Sort by name; the table must be ordered for the binary search.
set(GB_PAIRS "")
math(EXPR GB_LAST "${GB_COUNT} - 1")
foreach(GB_INDEX RANGE ${GB_LAST})
    list(GET GB_SHADER_NAMES ${GB_INDEX} GB_NAME)
    list(GET GB_SHADER_BINARIES ${GB_INDEX} GB_BINARY)
    list(APPEND GB_PAIRS "${GB_NAME}|${GB_BINARY}")
endforeach()
list(SORT GB_PAIRS COMPARE STRING)

set(GB_ARRAYS "")
set(GB_TABLE "")
set(GB_INDEX 0)
foreach(GB_PAIR IN LISTS GB_PAIRS)
    string(REPLACE "|" ";" GB_PAIR "${GB_PAIR}")
    list(GET GB_PAIR 0 GB_NAME)
    list(GET GB_PAIR 1 GB_BINARY)

    file(SIZE "${GB_BINARY}" GB_SIZE)
    math(EXPR GB_REMAINDER "${GB_SIZE} % 4")
    if(GB_SIZE LESS 20 OR NOT GB_REMAINDER EQUAL 0)
        message(FATAL_ERROR "${GB_BINARY} is not a SPIR-V module (${GB_SIZE} bytes)")
    endif()
    file(READ "${GB_BINARY}" GB_HEX HEX)
    # SPIR-V words are little-endian in the file; 0x07230203 is the SPIR-V magic number.
    if(NOT GB_HEX MATCHES "^03022307")
        message(FATAL_ERROR "${GB_BINARY} is not a SPIR-V module (bad magic number)")
    endif()
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u, " GB_WORDS "${GB_HEX}")
    # Eight words per line (CMake regular expressions have no {n} repetition).
    string(REPEAT "0x[0-9a-f]+u, " 8 GB_LINE_PATTERN)
    string(REGEX REPLACE "(${GB_LINE_PATTERN})" "\\1\n\t\t\t" GB_WORDS "${GB_WORDS}")
    string(REPLACE ", \n" ",\n" GB_WORDS "${GB_WORDS}")
    string(REGEX REPLACE "[ \n\t]+$" "" GB_WORDS "${GB_WORDS}")

    string(APPEND GB_ARRAYS "\t\t// ${GB_NAME}\n\t\tconstexpr uint32_t Shader${GB_INDEX}[] = {\n\t\t\t${GB_WORDS}\n\t\t};\n\n")
    string(APPEND GB_TABLE "\t\t\tEmbeddedShader{ \"${GB_NAME}\", Shader${GB_INDEX} },\n")
    math(EXPR GB_INDEX "${GB_INDEX} + 1")
endforeach()

set(GB_CONTENT "// Generated by cmake/GambitEmbedShaders.cmake from compiled SPIR-V. Do not edit.

#include \"${GB_HEADER}\"

#include <array>
#include <cstdint>
#include <span>

namespace Gambit::EmbeddedShaders
{
	namespace
	{
${GB_ARRAYS}\t\tconstexpr std::array<EmbeddedShader, ${GB_COUNT}> Shaders = {
${GB_TABLE}\t\t};
	}

	std::span<const EmbeddedShader> ${GB_FUNCTION}()
	{
		return Shaders;
	}
}
")

# Rewriting an unchanged file would only trigger needless recompiles.
set(GB_EXISTING "")
if(EXISTS "${GB_OUTPUT}")
    file(READ "${GB_OUTPUT}" GB_EXISTING)
endif()
if(NOT GB_EXISTING STREQUAL GB_CONTENT)
    file(WRITE "${GB_OUTPUT}" "${GB_CONTENT}")
endif()
