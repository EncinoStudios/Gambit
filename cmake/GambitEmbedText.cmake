# Script mode (cmake -P), run by gb_embed_lua_library: writes a C++ source that embeds text files (the engine's Lua
# library) as byte arrays plus a table sorted by name. Plain CMake, like the shader embedding (D-031): the files ship
# inside the binary, never as loose files.
#
# Inputs (-D): GB_MANIFEST (defines GB_EMBED_NAMES and GB_EMBED_FILES, parallel lists), GB_OUTPUT (the .cpp to write),
# GB_HEADER (the engine header that declares the table type and the function), GB_FUNCTION (the function's name).

cmake_minimum_required(VERSION 3.24)

foreach(GB_INPUT GB_MANIFEST GB_OUTPUT GB_HEADER GB_FUNCTION)
    if(NOT DEFINED ${GB_INPUT} OR "${${GB_INPUT}}" STREQUAL "")
        message(FATAL_ERROR "GambitEmbedText.cmake: ${GB_INPUT} is not set")
    endif()
endforeach()

include("${GB_MANIFEST}")
list(LENGTH GB_EMBED_NAMES GB_COUNT)
list(LENGTH GB_EMBED_FILES GB_FILE_COUNT)
if(GB_COUNT EQUAL 0 OR NOT GB_COUNT EQUAL GB_FILE_COUNT)
    message(FATAL_ERROR "GambitEmbedText.cmake: malformed manifest ${GB_MANIFEST}")
endif()

# Sorted by name, so the table can be binary searched.
set(GB_PAIRS "")
math(EXPR GB_LAST "${GB_COUNT} - 1")
foreach(GB_INDEX RANGE ${GB_LAST})
    list(GET GB_EMBED_NAMES ${GB_INDEX} GB_NAME)
    list(GET GB_EMBED_FILES ${GB_INDEX} GB_FILE)
    list(APPEND GB_PAIRS "${GB_NAME}|${GB_FILE}")
endforeach()
list(SORT GB_PAIRS COMPARE STRING)

set(GB_ARRAYS "")
set(GB_TABLE "")
set(GB_INDEX 0)
foreach(GB_PAIR IN LISTS GB_PAIRS)
    string(REPLACE "|" ";" GB_PAIR "${GB_PAIR}")
    list(GET GB_PAIR 0 GB_NAME)
    list(GET GB_PAIR 1 GB_FILE)

    file(READ "${GB_FILE}" GB_HEX HEX)
    string(LENGTH "${GB_HEX}" GB_HEX_LENGTH)
    math(EXPR GB_SIZE "${GB_HEX_LENGTH} / 2")
    if(GB_SIZE EQUAL 0)
        message(FATAL_ERROR "${GB_FILE} is empty")
    endif()
    string(REGEX REPLACE "(..)" "0x\\1, " GB_BYTES "${GB_HEX}")
    # The arrays are `char`: every byte must fit, so the files are ASCII.
    if(GB_BYTES MATCHES "0x[89a-f]")
        message(FATAL_ERROR "${GB_FILE} is not ASCII text")
    endif()
    # Sixteen bytes per line (CMake regular expressions have no {n} repetition).
    string(REPEAT "0x[0-9a-f][0-9a-f], " 16 GB_LINE_PATTERN)
    string(REGEX REPLACE "(${GB_LINE_PATTERN})" "\\1\n\t\t\t" GB_BYTES "${GB_BYTES}")
    string(REPLACE ", \n" ",\n" GB_BYTES "${GB_BYTES}")
    string(REGEX REPLACE "[ \n\t]+$" "" GB_BYTES "${GB_BYTES}")

    string(APPEND GB_ARRAYS "\t\t// ${GB_NAME}\n\t\tconstexpr char File${GB_INDEX}[] = {\n\t\t\t${GB_BYTES}\n\t\t};\n\n")
    string(APPEND GB_TABLE
        "\t\t\tEmbeddedTextFile{ \"${GB_NAME}\", std::string_view(File${GB_INDEX}, sizeof(File${GB_INDEX})) },\n")
    math(EXPR GB_INDEX "${GB_INDEX} + 1")
endforeach()

set(GB_CONTENT "// Generated by cmake/GambitEmbedText.cmake. Do not edit.

#include \"${GB_HEADER}\"

#include <array>
#include <span>
#include <string_view>

namespace Gambit
{
	namespace
	{
${GB_ARRAYS}\t\tconstexpr std::array<EmbeddedTextFile, ${GB_COUNT}> Files = {
${GB_TABLE}\t\t};
	}

	std::span<const EmbeddedTextFile> ${GB_FUNCTION}()
	{
		return Files;
	}
}
")

# Rewriting an unchanged file would only trigger needless recompiles.
set(GB_EXISTING "")
if(EXISTS "${GB_OUTPUT}")
    file(READ "${GB_OUTPUT}" GB_EXISTING)
endif()
if(NOT GB_EXISTING STREQUAL GB_CONTENT)
    file(WRITE "${GB_OUTPUT}" "${GB_CONTENT}")
endif()
